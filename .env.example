# PostgreSQL 连接串（docker compose 默认配置对应如下值）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview"

# Session JWT 签名密钥（任意 32 位以上随机字符串，可用 openssl rand -base64 32 生成）
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# 阿里云百炼（DashScope）API Key，用于 qwen-plus 对话与 qwen3-tts-flash 语音合成
# 获取方式：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxx"
